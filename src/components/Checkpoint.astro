---
// 检查点：做到这里应该满足的几条，可以打勾（打勾记在这个浏览器里，见 Site.astro）
import { langOf } from "../data/nav.js";
import { ui } from "../data/ui.js";
interface Props { id: string; items: string[]; done?: string }
const lang = langOf(Astro.url.pathname);
const T = ui(lang).checkpoint;
const { id, items, done = T.done } = Astro.props;
---
<div class="checkpoint" data-checkpoint={lang === "zh" ? id : `${lang}-${id}`}>
  <p class="checkpoint__title"><i data-xxd-icon="ListChecks" data-size="16"></i>{T.title}</p>
  <ul>
    {items.map((x) => <li><label><input type="checkbox" class="xxd-check" /><span set:html={x} /></label></li>)}
  </ul>
  <p class="checkpoint__done" hidden>✓ {done}</p>
</div>
