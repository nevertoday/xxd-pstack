---
// 首页、常见问题末尾的「提问和讨论」卡片（xxd 分层卡片 LayerCard）：到 GitHub 提问、讨论、分享做出来的东西；
// 作者的 X 只是一个安静的文字链接。下面洗色的一条：发截图前先打码。
import { langOf, link, fullLang, REPO } from "../data/nav.js";
import { X as dict } from "../i18n/index.js";
const lang = langOf(Astro.url.pathname);
const en = lang !== "zh";
const x = dict(lang);
const onFaq = Astro.url.pathname.replace(/\/$/, "").endsWith("/faq");
const ISSUE = `${REPO}/issues/new`;
const X = "https://x.com/xiaoxiaodong";
const T = en
  ? {
      h: "Questions and discussion",
      p: "Stuck on a step, found something unclear, or built something with pstack you'd like to show? Bring it to GitHub. The questions that come up most get worked into the guide. Writing in your own language is fine.",
      faq: ["Before asking, check the ", "FAQ", ": many answers are already there."],
      btn: "Ask or discuss on GitHub",
      x: "The author is on X",
      privacy: "Before sending screenshots, blur out API keys, company code and account details.",
    }
  : {
      h: "提问和讨论",
      p: "卡在哪一步、哪里没写清楚，或者想分享你用 pstack 做出来的东西，都欢迎到 GitHub 上提出来。问得多的，我会补进教程。",
      faq: ["问之前可以先看看", "常见问题", "，很多答案已经在那里了。"],
      btn: "到 GitHub 提问或讨论",
      x: "作者在 X 上",
      privacy: "发截图前，先把 API Key、公司代码和账号信息打码。",
    };
if (x) Object.assign(T, x.comp.contact);
---
<section class="xxd-layer contact" aria-labelledby="h-contact">
  <div class="xxd-layer__primary contact__body">
    <h2 id="h-contact">{T.h}</h2>
    <p>{T.p}</p>
    {!onFaq && <p class="contact__faq">{T.faq[0]}<a href={link("/faq/", fullLang(lang))}>{T.faq[1]}</a>{T.faq[2]}</p>}
    <div class="contact__btns">
      <a class="xxd-btn" href={ISSUE} rel="noopener"><i data-xxd-icon="MessagesSquare" data-size="16"></i>{T.btn}</a>
      <a class="xxd-link contact__x" href={X} rel="noopener">{T.x}<i data-xxd-icon="ArrowUpRight" data-size="14"></i></a>
    </div>
  </div>
  <p class="xxd-layer__secondary contact__note"><i data-xxd-icon="EyeOff" data-size="14"></i>{T.privacy}</p>
</section>
