---
// 主线教程的一步：进度、标题、预计时间，正文，上一步 / 下一步
import Site from "./Site.astro";
import Feedback from "../components/Feedback.astro";
import { STEPS, stepHref, langOf, t } from "../data/nav.js";
const { frontmatter, headings = [] } = Astro.props;
const lang = langOf(Astro.url.pathname);
const en = lang === "en";
const i = STEPS.findIndex((s) => s.n === frontmatter.step);
const s = STEPS[i], prev = STEPS[i - 1], next = STEPS[i + 1];
const last = STEPS[STEPS.length - 1].n;
const title = t(s, "title", lang);
const T = en
  ? { head: `Step ${s.n}: ${title}`, eyebrow: `Full guide · step ${s.n} of ${last}`, prog: `Progress: step ${s.n} of ${last}`, need: "You need: ", nav: "Previous and next step", prev: "Previous", next: "Next", pending: "Next (in progress)" }
  : { head: `第 ${s.n} 步：${title}`, eyebrow: `完整教程 · 第 ${s.n} 步，共 ${last} 步`, prog: `进度：第 ${s.n} 步，共 ${last} 步`, need: "要准备：", nav: "上一步和下一步", prev: "上一步", next: "下一步", pending: "下一步（编写中）" };
---
<Site title={T.head} description={frontmatter.description ?? t(s, "sum", lang)} headings={headings}>
  <header class="step-head">
    <div class="step-head__eyebrow"><span>{T.eyebrow}</span><span>{t(s, "minutes", lang)}</span></div>
    <progress class="xxd-progress" value={s.n} max={last} aria-label={T.prog}></progress>
    <h1>{title}</h1>
    {frontmatter.tldr && <p class="page-tldr"><span class="page-tldr__label">{en ? "In one line" : "一句话"}</span>{frontmatter.tldr}</p>}
    <div class="step-head__meta">
      {frontmatter.need && <span class="xxd-badge">{T.need}{frontmatter.need}</span>}
    </div>
  </header>
  <article class="xxd-prose"><slot /></article>
  <Feedback page={en ? `Step ${s.n} ${title}` : `第 ${s.n} 步 ${title}`} />
  <nav class="prevnext" aria-label={T.nav}>
    {prev && (prev.ready
      ? <a href={stepHref(prev, lang)} data-dir="prev"><small>{T.prev}</small>{prev.n}. {t(prev, "title", lang)}</a>
      : <span data-dir="prev"><small>{T.prev}</small>{prev.n}. {t(prev, "title", lang)}</span>)}
    {next && (next.ready
      ? <a href={stepHref(next, lang)} data-dir="next"><small>{T.next}</small>{next.n}. {t(next, "title", lang)}</a>
      : <span data-dir="next"><small>{T.pending}</small>{next.n}. {t(next, "title", lang)}</span>)}
  </nav>
</Site>
