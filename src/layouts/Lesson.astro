---
// 新手入门的一课：第几课、预计时间、正文，上一课 / 下一课。最后一课的「下一步」指回首页的「接下来」。
import Site from "./Site.astro";
import Feedback from "../components/Feedback.astro";
import { LESSONS, lessonHref, link, langOf, t } from "../data/nav.js";
import { X as dict, fmt } from "../i18n/index.js";
const { frontmatter, headings = [] } = Astro.props;
const lang = langOf(Astro.url.pathname);
const en = lang === "en";
const i = LESSONS.findIndex((s) => s.n === frontmatter.lesson);
const s = LESSONS[i], prev = LESSONS[i - 1], next = LESSONS[i + 1];
const total = LESSONS.length;
const title = t(s, "title", lang);
const x = dict(lang);
const T = x
  ? { eyebrow: fmt(x.lesson.eyebrow, { n: s.n, total }), prog: fmt(x.lesson.prog, { n: s.n, total }), nav: x.lesson.nav, prev: x.lesson.prev, next: x.lesson.next, tldr: x.lesson.tldr, title: fmt(x.lesson.title, { n: s.n, title }) }
  : en
  ? { eyebrow: `Beginner track · lesson ${s.n} of ${total}`, prog: `Progress: lesson ${s.n} of ${total}`, nav: "Previous and next lesson", prev: "Previous", next: "Next" }
  : { eyebrow: `新手入门 · 第 ${s.n} 课，共 ${total} 课`, prog: `进度：第 ${s.n} 课，共 ${total} 课`, nav: "上一课和下一课", prev: "上一课", next: "下一课" };
---
<Site title={x ? T.title : en ? `Lesson ${s.n}: ${title}` : `第 ${s.n} 课：${title}`} description={frontmatter.description ?? t(s, "sum", lang)} headings={headings} literal={frontmatter.cmds === "literal"}>
  <header class="step-head">
    <div class="step-head__eyebrow"><span>{T.eyebrow}</span><span>{t(s, "minutes", lang)}</span></div>
    <progress class="xxd-progress" value={s.n} max={total} aria-label={T.prog}></progress>
    <h1>{title}</h1>
    {frontmatter.tldr && <p class="page-tldr"><span class="page-tldr__label">{x ? T.tldr : en ? "In one line" : "一句话"}</span>{frontmatter.tldr}</p>}
  </header>
  <article class="xxd-prose"><slot /></article>
  <Feedback page={x ? `[${lang}] Lesson ${s.n} ${t(s, "title", "en")}` : en ? `Lesson ${s.n} ${title}` : `第 ${s.n} 课 ${title}`} />
  <nav class="prevnext" aria-label={T.nav}>
    {prev && <a href={lessonHref(prev, lang)} data-dir="prev"><small>{T.prev}</small>{prev.n}. {t(prev, "title", lang)}</a>}
    {next && <a href={lessonHref(next, lang)} data-dir="next"><small>{T.next}</small>{next.n}. {t(next, "title", lang)}</a>}
  </nav>
</Site>
