---
// 新手入门的一课：第几课、预计时间、正文，上一课 / 下一课。最后一课的「下一步」指回首页的「接下来」。
import Site from "./Site.astro";
import Feedback from "../components/Feedback.astro";
import { LESSONS, lessonHref, langOf, t } from "../data/nav.js";
import { ui } from "../data/ui.js";
import { fmt } from "../l10n/load.js";
const { frontmatter, headings = [] } = Astro.props;
const lang = langOf(Astro.url.pathname);
const i = LESSONS.findIndex((s) => s.n === frontmatter.lesson);
const s = LESSONS[i], prev = LESSONS[i - 1], next = LESSONS[i + 1];
const total = LESSONS.length;
const title = t(s, "title", lang);
const T = ui(lang).lesson;
const v = { n: s.n, total, title };
// 反馈的 issue 标题：其他语言标上语言、用英文标题（维护者看得懂）
const page = lang === "zh" ? `第 ${s.n} 课 ${title}` : lang === "en" ? `Lesson ${s.n} ${title}` : `[${lang}] Lesson ${s.n} ${t(s, "title", "en")}`;
---
<Site title={fmt(T.title, v)} description={frontmatter.description ?? t(s, "sum", lang)} headings={headings} literal={frontmatter.cmds === "literal"}>
  <header class="step-head">
    <div class="step-head__eyebrow"><span>{fmt(T.eyebrow, v)}</span><span>{t(s, "minutes", lang)}</span></div>
    <progress class="xxd-progress" value={s.n} max={total} aria-label={fmt(T.prog, v)}></progress>
    <h1>{title}</h1>
    {frontmatter.tldr && <p class="page-tldr"><span class="page-tldr__label">{T.tldr}</span>{frontmatter.tldr}</p>}
  </header>
  <article class="xxd-prose"><slot /></article>
  <Feedback page={page} />
  <nav class="prevnext" aria-label={T.nav}>
    {prev && <a href={lessonHref(prev, lang)} data-dir="prev"><small>{T.prev}</small>{prev.n}. {t(prev, "title", lang)}</a>}
    {next && <a href={lessonHref(next, lang)} data-dir="next"><small>{T.next}</small>{next.n}. {t(next, "title", lang)}</a>}
  </nav>
</Site>
