---
import Site from "../layouts/Site.astro";
import Q from "../components/Q.astro";
import Contact from "../components/Contact.astro";
import { FAQ } from "../data/faq.js";
import { REPO } from "../data/nav.js";
import { inline } from "../lib/md.js";
const headings = FAQ.map((g) => ({ slug: g.id, text: g.title, depth: 2 }));
---
<Site title="常见问题" headings={headings}>
  <article class="xxd-prose">
    <h1>常见问题</h1>
    <p>第一次接触 pstack 时最常冒出来的问题。没找到你的？到 <a href={`${REPO}/issues`}>GitHub</a> 提一个，或者按 <kbd class="xxd-kbd">⌘K</kbd> 搜索全站。</p>
    {FAQ.map((g) => (
      <>
        <h2 id={g.id}>{g.title}</h2>
        {g.items.map(([q, a], i) => <Q q={q} group={g.id} id={`${g.id}-${i + 1}`}><p set:html={inline(a)} /></Q>)}
      </>
    ))}
    <Contact />
  </article>
</Site>
