---
// 首页：先对没写过代码的新人说话（遇到过的事 → 装上以后的不同 → 三课入门 → 适不适合），
// 最后才是给会写代码的人的一张图和完整教程路线。
import Site from "../layouts/Site.astro";
import Contact from "../components/Contact.astro";
import { LESSONS, lessonHref, STEPS, stepHref, link, langOf, t } from "../data/nav.js";
import { inline } from "../lib/md.js";

const lang = langOf(Astro.url.pathname);
const ZH = {
  brand: "pstack 新手教程",
  h1: "AI 说「做好了」之前，先让它自己试一遍",
  lead: ["pstack 是一份装进 AI 里的做事规矩，免费开源。装上以后，AI 会先弄清你要什么，只改该改的地方。", "不会写代码也能用", "。"],
  cta: ["新手从这里开始", "我会写代码，看完整教程"],
  ctaNote: "新手入门一共三课，20 分钟。",
  painH: "你是不是遇到过这些",
  PAIN: [
    "AI 说「做好了」，你一打开，按钮点了没反应。",
    "你说「还是不行」，它说「抱歉，已修复」，结果还是一样，来回好几次。",
    "你只想改一个地方，它顺手改了一堆你没让它动的东西。",
  ],
  diffH: "装上以后，有什么不一样",
  diffW: "什么时候", diffA: "平常的 AI", diffB: "装了 pstack",
  DIFF: [
    ["动手之前", "没弄清你要什么，直接就做", "先用自己的话复述一遍，你能马上纠正"],
    ["改的时候", "在看起来差不多的地方乱改", "先把问题弄清楚再动手，改得越少越好"],
    ["说做完的时候", "一句「应该没问题了」", "列出实际检查过什么、看到了什么；查不了的直说"],
  ],
  lessonsH: "新手只要三课", lessonsP: "按顺序看，一共 20 分钟。学完这三课就会用了，网站上其他内容都是以后遇到了再查。",
  lessonsLabel: "新手入门：共 3 课",
  fitH: "适不适合你", yesH: "适合", noH: "先不用",
  YES: ["用 AI 做过小网页、小插件、小工具，被「已完成但其实没好」坑过", "已经装了 Claude Code（或 Cursor、Codex），能在里面和 AI 聊天", "想要做对，不在乎慢一点"],
  NO: ["还没用过 Claude Code 这类工具：先照官方指南装好，能聊天了再来", "改个错别字、换个颜色这种小事：直接跟 AI 说就行", "只要最快、最省额度：pstack 会多检查，更慢，也更费额度"],
  devH: "会写代码的人看这里",
  devP: "pstack 是 poteto（React 核心团队成员，在 Cursor 工作）每天自己写代码用的一包技能：34 个技能、23 套剧本、24 条工程原则。下面是它每接一件事走的四步，和 9 步的完整教程。",
  FLOW: [
    ["MessageCircle", "你说一句话", "目标，加上怎么算做完。比如「先复现，再修，再验证」。"],
    ["Route", "/poteto-mode 挑剧本", "从 23 套剧本里选一套，把它的步骤原样抄进待办清单。"],
    ["Layers", "按步骤调用技能", "读代码用 /how，定设计用 /architect，挑刺用 /interrogate；活多就派子代理。"],
    ["ShieldCheck", "检查完再交回来", "真实的命令输出、截图、前后对比。验证不了的，直说「没法确定」。"],
  ],
  CONN: ["匹配", "执行", "验证"],
  stepsLabel: (n) => `完整教程：共 ${n} 步`,
};
const EN = {
  brand: "pstack for beginners",
  h1: "Before the AI says “done,” make it try the thing itself",
  lead: ["pstack is a free, open-source set of work rules you install into your AI. With it, the AI first makes sure it knows what you want, then changes only what needs changing. ", "You don't need to know how to code", "."],
  cta: ["Start here if you're new", "I code: the full guide"],
  ctaNote: "The beginner track is three lessons, 20 minutes.",
  painH: "Has this happened to you?",
  PAIN: [
    "The AI says “done!” You open it, and the button does nothing.",
    "You say “still broken.” It says “sorry, fixed now.” Same result, again and again.",
    "You wanted one small change, and it changed a pile of things you never asked about.",
  ],
  diffH: "What changes once it's installed",
  diffW: "When", diffA: "AI as usual", diffB: "With pstack",
  DIFF: [
    ["Before it starts", "Starts without checking what you want", "Repeats your goal in its own words first, so you can correct it right away"],
    ["While it changes things", "Changes things somewhere that looks about right", "Figures out the problem first, then changes as little as it can"],
    ["When it says it's done", "“Should be fine now”", "Lists what it actually checked and what it saw, and says plainly what it couldn't check"],
  ],
  lessonsH: "Beginners need just three lessons", lessonsP: "Read them in order, 20 minutes in all. After these three you can use it. Everything else on the site is for looking up later.",
  lessonsLabel: "Beginner track: 3 lessons",
  fitH: "Is it for you?", yesH: "Yes, if", noH: "Not yet, if",
  YES: ["You've made small pages, plug-ins or tools with AI and been burned by “done” that wasn't", "You already have Claude Code (or Cursor or Codex) and can chat with the AI in it", "You'd rather get it right than get it fast"],
  NO: ["You haven't used a tool like Claude Code yet: install it with the official guide first, and come back once you can chat", "It's a tiny change like a typo or a color: just ask the AI directly", "You only want fastest and cheapest: pstack checks more, so it's slower and uses more of your plan"],
  devH: "If you write code",
  devP: "pstack is the pack of skills poteto (on the React core team, working at Cursor) uses for their own code every day: 34 skills, 23 playbooks and 24 engineering principles. Below are the four steps it takes for every task, and the 9-step full guide.",
  FLOW: [
    ["MessageCircle", "You say one sentence", "The goal, plus how you'll know it's done. For example: “reproduce it first, then fix, then verify.”"],
    ["Route", "/poteto-mode picks a playbook", "It chooses one of 23 playbooks and copies its steps into the todo list as they are."],
    ["Layers", "Skills run step by step", "/how to read code, /architect to settle a design, /interrogate to pick holes; subagents when there's a lot to do."],
    ["ShieldCheck", "It checks before handing back", "Real command output, screenshots, before-and-after. If something can't be verified, it says so."],
  ],
  CONN: ["match", "do", "verify"],
  stepsLabel: (n) => `Full guide: ${n} steps`,
};
const C = lang === "en" ? EN : ZH;
---
<Site title={C.brand} wide>
  <div class="home">
    <h1>{C.h1}</h1>
    <p class="home__lead">{C.lead[0]}<mark>{C.lead[1]}</mark>{C.lead[2]}</p>
    <div class="home__cta">
      <a class="xxd-btn" data-variant="primary" href={lessonHref(LESSONS[0], lang)}>{C.cta[0]}<i data-xxd-icon="ArrowRight" data-size="16"></i></a>
      <a class="xxd-btn" data-variant="ghost" href={stepHref(STEPS[0], lang)}>{C.cta[1]}</a>
    </div>
    <p class="home__note">{C.ctaNote}</p>

    <section aria-labelledby="h-pain">
      <h2 id="h-pain">{C.painH}</h2>
      <ul class="pain">{C.PAIN.map((x) => <li>{x}</li>)}</ul>
    </section>

    <section aria-labelledby="h-diff">
      <h2 id="h-diff">{C.diffH}</h2>
      <div class="xxd-table-wrap diff">
        <table class="xxd-table">
          <thead><tr><th scope="col">{C.diffW}</th><th scope="col" data-wrap>{C.diffA}</th><th scope="col" data-wrap>{C.diffB}</th></tr></thead>
          <tbody>{C.DIFF.map(([w, a, b]) => <tr><th scope="row" class="diff__when">{w}</th><td data-wrap class="diff__before">{a}</td><td data-wrap>{b}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="h-lessons">
      <h2 id="h-lessons">{C.lessonsH}</h2>
      <p>{C.lessonsP}</p>
      <ol class="xxd-steps roadmap" data-vertical aria-label={C.lessonsLabel}>
        {LESSONS.map((s) => (
          <li class="xxd-steps__item">
            <span class="xxd-steps__mark" aria-hidden="true">{s.n}</span>
            <span class="xxd-steps__text">
              <a class="xxd-steps__title xxd-steps__link" href={lessonHref(s, lang)}>{t(s, "title", lang)}</a>
              <span class="xxd-steps__desc">{t(s, "minutes", lang)} · {t(s, "sum", lang)}</span>
            </span>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="h-fit">
      <h2 id="h-fit">{C.fitH}</h2>
      <div class="fit">
        <div class="route"><h3><i data-xxd-icon="CircleCheck" data-size="18"></i>{C.yesH}</h3><ul>{C.YES.map((x) => <li>{x}</li>)}</ul></div>
        <div class="route"><h3><i data-xxd-icon="CircleX" data-size="18"></i>{C.noH}</h3><ul>{C.NO.map((x) => <li>{x}</li>)}</ul></div>
      </div>
    </section>

    <section aria-labelledby="h-dev">
      <h2 id="h-dev">{C.devH}</h2>
      <p>{C.devP}</p>
      <div class="flow">
        {C.FLOW.map(([icon, h, p], i) => (
          <>
            {i > 0 && (
              <div class="flow__conn" aria-hidden="true">
                <span class="flow__label">{C.CONN[i - 1]}</span>
                <span class="flow__track"><span class="flow__dot" style={`animation-delay:${(i - 1) * 1.2}s`}></span><i class="flow__head" data-xxd-icon="ChevronRight" data-size="14"></i></span>
              </div>
            )}
            <div class="flow__box" data-mine={i === 1 ? "" : undefined}>
              <i class="flow__icon" data-xxd-icon={icon} data-size="20"></i>
              <p class="flow__title">{h}</p>
              <p class="flow__desc">{p}</p>
            </div>
          </>
        ))}
      </div>
      <ol class="xxd-steps roadmap" data-vertical start={STEPS[0].n} aria-label={C.stepsLabel(STEPS.length)}>
        {STEPS.map((s) => (
          <li class="xxd-steps__item">
            <span class="xxd-steps__mark" aria-hidden="true">{s.n}</span>
            <span class="xxd-steps__text">
              <a class="xxd-steps__title xxd-steps__link" href={stepHref(s, lang)}>{t(s, "title", lang)}</a>
              <span class="xxd-steps__desc">{t(s, "minutes", lang)} · {t(s, "sum", lang)}</span>
            </span>
          </li>
        ))}
      </ol>
    </section>

    <Contact />
  </div>
</Site>
