---
// 首页：一张图看懂（你的一句话 → /poteto-mode 挑剧本 → 调技能 → 带证据交回）、好处、两种用法、完整路线（xxd-steps 竖排）、适不适合、反馈
import Site from "../layouts/Site.astro";
import Contact from "../components/Contact.astro";
import { STEPS, stepHref, link } from "../data/nav.js";
import { SKILL_COUNT } from "../data/skills.js";
import { inline } from "../lib/md.js";

const FLOW = [
  ["MessageCircle", "你说一句话", "目标，加上怎么算做完。比如「先复现，再修，再验证」。"],
  ["Route", "/poteto-mode 挑剧本", "从 23 套剧本里选一套，把它的步骤原样抄进待办清单。"],
  ["Layers", "按步骤调用技能", "读代码用 /how，定设计用 /architect，挑刺用 /interrogate；活多就派子代理。"],
  ["ShieldCheck", "带着证据交回来", "真实的命令输出、截图、前后对比。验证不了的，直说「没法确定」。"],
];
const CONN = ["匹配", "执行", "验证"];
const HOW = [
  "它先用自己的话复述你的目标，匹配到「修 bug」剧本，待办清单里出现：复现 → 找根因 → 修 → 验证 → 开 PR。",
  "它先真的把重复写入跑出来，再用 /how 读懂相关代码，找到第一个出错的地方，而不是在表面加一层去重了事。",
  "修完再跑一遍同样的复现步骤，把修之前和修之后的输出都贴给你看。",
];
const GET = [
  ["少写，但写得好", "第一条原则就是「能删就删，用最小的改动解决问题」。它追求的不是代码行数，正好相反。"],
  ["不再听「应该好了」", "每个任务都要拿真实证据收尾：跑真命令、读真数据、点真界面。「编译通过」不算数。"],
  ["敢同时开好几个 AI", "每个 AI 都按同一套规矩干活、各用各的 worktree，你可以放心并行，不用一个个盯着。"],
  ["越用越像你", "同一个错犯两次，就用 /correct 从根上堵住；用熟了，用 /automate-me 生成你自己的工作模式。"],
];
const ROUTES = [
  ["Route", "只打 /poteto-mode（推荐）", "说清楚目标和怎么算做完，剩下的它安排。大部分时候你只需要这一个命令。"],
  ["Puzzle", "按需点名单个技能", "只想看懂代码就 /how，只想把回复翻成人话就 /bro。不想装全套，也可以只挑几个装。"],
];
const YES = ["已经在用 Claude Code、Cursor 或 Codex 写代码，觉得 AI 改得快、但不够靠谱", "做的是要长期维护的真实项目，在乎质量和可审查", "愿意多花一点 token 和时间，换来少返工"];
const NO = ["还没用过任何 AI 编程工具：先把工具本身用起来，再回来", "只要最快、最便宜：pstack 会多派子代理、多做检查，更慢也更费 token", "一次性的小脚本、改一行文案：直接让 AI 改就行，用不上这么重的流程"];
---
<Site title="pstack 新手教程" wide>
  <div class="home">
    <h1>让 AI 写代码像个靠谱的资深工程师：先搞懂，再动手，拿出证据</h1>
    <p class="home__lead">pstack 是一包免费开源的 AI 编程「技能」：{SKILL_COUNT} 个技能，加 24 条工程原则。作者 poteto 在 Cursor 工作，也是 React 核心团队成员，这是作者每天自己写代码用的那一套。装进 Claude Code、Cursor 或 Codex 之后，你只要说清楚要什么、怎么算做完，剩下的它按资深工程师的规矩来：<mark>先搞懂，再动手，拿出证据</mark>。</p>
    <div class="home__cta">
      <a class="xxd-btn" data-variant="primary" href={stepHref(STEPS[0])}>从第 0 步开始<i data-xxd-icon="ArrowRight" data-size="16"></i></a>
      <a class="xxd-btn" href={link("/skills/")}>看技能速查</a>
      <a class="xxd-btn" data-variant="ghost" href={link("/howto/recipes/")}>直接抄提示词</a>
    </div>

    <section aria-labelledby="h-flow">
      <h2 id="h-flow">一张图看懂</h2>
      <p>你每次交代一件事，pstack 都走这四步。中间两步你不用管，但能在待办清单里看得一清二楚。</p>
      <div class="flow">
        {FLOW.map(([icon, h, p], i) => (
          <>
            {i > 0 && (
              <div class="flow__conn" aria-hidden="true">
                <span class="flow__label">{CONN[i - 1]}</span>
                <span class="flow__track"><span class="flow__dot" style={`animation-delay:${(i - 1) * 1.2}s`}></span><i class="flow__head" data-xxd-icon="ChevronRight" data-size="14"></i></span>
              </div>
            )}
            <div class="flow__box" data-mine={i === 1 ? "" : undefined}>
              <i class="flow__icon" data-xxd-icon={icon} data-size="20"></i>
              <p class="flow__title">{h}</p>
              <p class="flow__desc">{p}</p>
            </div>
          </>
        ))}
      </div>
      <p class="flow__how-h">比如你说「导出偶尔会写出重复的行，先复现，再修，再验证」：</p>
      <ol class="flow__how">{HOW.map((x) => <li set:html={inline(x)} />)}</ol>
      <p class="flow__note"><i data-xxd-icon="Info" data-size="14"></i>你不用记技能名，也不用写长篇需求。pstack 的价值在于：AI 平时容易跳过的那几步（复现、读代码、找根因、验证），现在一步都不会少；真要跳过，也会在清单里写明理由。</p>
    </section>

    <section aria-labelledby="h-get">
      <h2 id="h-get">用了有什么好处</h2>
      <ul class="xxd-list">
        {GET.map(([a, b]) => <li class="xxd-list__item"><div class="xxd-list__main"><div class="xxd-list__title">{a}</div><div class="xxd-list__meta" set:html={inline(b)} /></div></li>)}
      </ul>
    </section>

    <section aria-labelledby="h-routes">
      <h2 id="h-routes">两种用法，从第一种开始</h2>
      <p>两种可以混着用。新手先只记 /poteto-mode 一个命令。</p>
      <div class="routes">
        {ROUTES.map(([icon, h, p]) => <div class="route"><h3><i data-xxd-icon={icon} data-size="18"></i>{h}</h3><p>{p}</p></div>)}
      </div>
    </section>

    <section aria-labelledby="h-steps">
      <h2 id="h-steps">完整路线</h2>
      <p>第一次按顺序看，前 4 步（装好、配好、跑通第一个任务）大约 40 分钟。之后每一页都能单独查。</p>
      <ol class="xxd-steps roadmap" data-vertical start={STEPS[0].n} aria-label={`完整路线：共 ${STEPS.length} 步，从第 ${STEPS[0].n} 步开始`}>
        {STEPS.map((s) => (
          <li class="xxd-steps__item">
            <span class="xxd-steps__mark" aria-hidden="true">{s.n}</span>
            <span class="xxd-steps__text">
              {s.ready
                ? <a class="xxd-steps__title xxd-steps__link" href={stepHref(s)}>{s.title}</a>
                : <span class="xxd-steps__title">{s.title}<span class="xxd-badge roadmap__pending">编写中</span></span>}
              <span class="xxd-steps__desc">{s.minutes} · {s.sum}</span>
            </span>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="h-fit">
      <h2 id="h-fit">适不适合你</h2>
      <div class="fit">
        <div class="route"><h3><i data-xxd-icon="CircleCheck" data-size="18"></i>适合</h3><ul>{YES.map((x) => <li>{x}</li>)}</ul></div>
        <div class="route"><h3><i data-xxd-icon="CircleX" data-size="18"></i>不太适合</h3><ul>{NO.map((x) => <li>{x}</li>)}</ul></div>
      </div>
    </section>

    <Contact />
  </div>
</Site>
