---
import Site from "../layouts/Site.astro";
import { HOWTO, howtoHref, langOf, t } from "../data/nav.js";
const lang = langOf(Astro.url.pathname);
const en = lang === "en";
const headings = HOWTO.map((g, i) => ({ slug: `g${i}`, text: t(g, "group", lang), depth: 2 }));
const T = en
  ? { h: "How-to: how exactly", p: "Each article covers one thing. The main guide is about how pstack thinks; this is about what to actually say to it for the job in front of you. Every article has prompts you can copy." }
  : { h: "How-to：具体怎么做", p: "一篇只讲一件事。主线教程讲的是「pstack 怎么想问题」，这里讲的是「我手上这件活，具体该怎么跟它说」。每篇都有能直接复制的提示词。" };
---
<Site title={T.h} headings={headings}>
  <article class="xxd-prose">
    <h1>{T.h}</h1>
    <p>{T.p}</p>
    {HOWTO.map((g, i) => (
      <>
        <h2 id={`g${i}`}>{t(g, "group", lang)}</h2>
        <ul class="xxd-list" data-interactive>
          {g.items.map((it) => <li class="xxd-list__item"><a class="xxd-list__main list-link" href={howtoHref(it.slug, lang)}><span class="xxd-list__title">{t(it, "title", lang)}</span></a></li>)}
        </ul>
      </>
    ))}
  </article>
</Site>
