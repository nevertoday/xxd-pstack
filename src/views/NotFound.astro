---
import Site from "../layouts/Site.astro";
import { LESSONS, lessonHref, link, langOf } from "../data/nav.js";
import { ui } from "../data/ui.js";
const lang = langOf(Astro.url.pathname);
const T = ui(lang).notFound;
---
<Site title={T.h}>
  <article class="xxd-prose">
    <h1>{T.h}</h1>
    <p>{T.p[0]}<kbd class="xxd-kbd">⌘K</kbd>{T.p[1]}</p>
    <ul>
      <li><a href={link("/", lang)}>{T.home}</a></li>
      <li><a href={lessonHref(LESSONS[0], lang)}>{T.step0}</a></li>
      <li><a href={link("/skills/", lang)}>{T.skills}</a></li>
      <li><a href={link("/faq/", lang)}>{T.faq}</a></li>
    </ul>
  </article>
</Site>
