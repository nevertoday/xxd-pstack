---
// 一个 Wiki 条目：一句话、打个比方、在 pstack 里、（可选）清单、常见误区、动手操作、相关条目
import Site from "../layouts/Site.astro";
import { WIKI } from "../data/wiki.js";
import { wikiHref, howtoHref, stepHref, HOWTO_FLAT, STEPS, link } from "../data/nav.js";
import { inline } from "../lib/md.js";
interface Props { slug: string }
const w = WIKI.find((x) => x.slug === Astro.props.slug);
const titleOf = (slug) => { const x = WIKI.find((y) => y.slug === slug); if (!x) throw new Error(`Wiki 里没有 ${slug}`); return x.title; };
const howto = w.howto && HOWTO_FLAT.find((h) => h.slug === w.howto);
const step = w.step !== undefined && STEPS.find((s) => s.n === w.step);
const headings = [
  { slug: "like", text: "打个比方", depth: 2 },
  { slug: "here", text: "在 pstack 里", depth: 2 },
  ...(w.list ? [{ slug: "list", text: w.listTitle ?? "清单", depth: 2 }] : []),
  { slug: "myths", text: "常见误区", depth: 2 },
];
---
<Site title={`${w.title} · Wiki`} description={w.one} headings={headings}>
  <article class="xxd-prose wiki">
    <ol class="xxd-breadcrumbs" data-size="sm"><li><a href={link("/wiki/")}>Wiki</a></li><li>{w.group}</li><li aria-current="page">{w.title}</li></ol>
    <h1>{w.title}</h1>
    <p class="wiki__one" set:html={inline(w.one)} />
    <h2 id="like">打个比方</h2>
    <p set:html={inline(w.like)} />
    <h2 id="here">在 pstack 里</h2>
    {(Array.isArray(w.here) ? w.here : [w.here]).map((p) => <p set:html={inline(p)} />)}
    {w.list && (
      <>
        <h2 id="list">{w.listTitle ?? "清单"}</h2>
        <table>
          <thead><tr><th>{w.listHead?.[0] ?? "名字"}</th><th>{w.listHead?.[1] ?? "说人话"}</th></tr></thead>
          <tbody>{w.list.map(([a, b]) => <tr><td set:html={inline(a)} /><td set:html={inline(b)} /></tr>)}</tbody>
        </table>
      </>
    )}
    <h2 id="myths">常见误区</h2>
    <ul>{w.myths.map((m) => <li set:html={inline(m)} />)}</ul>
    {(howto || step) && <p>动手操作：{step && <a href={stepHref(step)}>主线第 {step.n} 步：{step.title}</a>}{howto && step && "、"}{howto && <a href={howtoHref(howto.slug)}>{howto.title}</a>}</p>}
    {w.see?.length > 0 && <p class="wiki__see">相关条目：{w.see.map((s, i) => <>{i > 0 && "、"}<a href={wikiHref(s)}>{titleOf(s)}</a></>)}</p>}
  </article>
</Site>
