---
import Site from "../layouts/Site.astro";
import { WIKI, WIKI_GROUPS } from "../data/wiki.js";
import { WIKI_EN, WIKI_GROUPS_EN } from "../data/wiki.en.js";
import { wikiHref, link, langOf } from "../data/nav.js";
const lang = langOf(Astro.url.pathname);
const en = lang === "en";
const items = WIKI.map((w) => (en ? { ...w, ...WIKI_EN[w.slug], group: w.group } : w));
const gName = (g) => (en ? WIKI_GROUPS_EN[g] : g);
const headings = WIKI_GROUPS.map((g, i) => ({ slug: `g${i}`, text: gName(g), depth: 2 }));
const T = en
  ? { h: "Wiki: what is it", p1: "Every idea that shows up in the guide, explained. Each entry has the same shape: one sentence → an analogy → in pstack → common misconceptions.", p2: ["Don't want the full article? Hover over any word with a dotted underline in the guide for a one-line explanation; click it to come here. To look up a skill by name, see ", "Skills at a glance", "."] }
  : { h: "Wiki：这是什么", p1: "讲清楚教程里出现的每个概念。每篇都是同样的结构：一句话解释 → 打个比方 → 在 pstack 里 → 常见误区。", p2: ["不想看完整文章的话：教程正文里带虚线的词，鼠标停在上面就能看到一句话解释，点一下进到这里。想按名字查某个技能，去", "技能速查", "。"] };
---
<Site title={T.h} headings={headings}>
  <article class="xxd-prose">
    <h1>{T.h}</h1>
    <p>{T.p1}</p>
    <p>{T.p2[0]}<a href={link("/skills/", lang)}>{T.p2[1]}</a>{T.p2[2]}</p>
    {WIKI_GROUPS.map((g, i) => (
      <>
        <h2 id={`g${i}`}>{gName(g)}</h2>
        <ul class="xxd-list" data-interactive>
          {items.filter((w) => w.group === g).map((w) => (
            <li class="xxd-list__item"><a class="xxd-list__main list-link" href={wikiHref(w.slug, lang)}><span class="xxd-list__title">{w.title}</span><span class="xxd-list__meta">{w.one.replace(/\*\*|==|\+\+/g, "")}</span></a></li>
          ))}
        </ul>
      </>
    ))}
  </article>
</Site>
